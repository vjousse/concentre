{
  "name": "concentre",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "review": "elm-review",
    "review:fix": "npm run review -- --fix",
    "tauri": "tauri",
    "setup": "elm-tooling install",
    "test:elm": "elm-test-rs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:elm && npm run test:rust"
  },
  "devDependencies": {
    "@lydell/elm": "^0.19.1-14",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "elm-debug-transformer": "^1.2.1",
    "elm-review": "^2.13.5",
    "elm-tooling": "^1.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-elm": "^3.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-shell": "^2"
  },
  "overrides": {
    "esbuild": "0.27.4"
  }
}
